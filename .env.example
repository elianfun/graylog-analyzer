# 複製為 .env 後填入實際值（.env 已列入 .gitignore，不會上傳）
GRAYLOG_TOKEN=your_graylog_api_token
LLM_API_KEY=your_internal_llm_key

# 外部 LLM（僅搭配 mask: true 使用）
EXTERNAL_API_KEY=your_external_llm_key

# 選用：Email / LINE
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SENDER=you@example.com
# SMTP_PASSWORD=your_app_password
# SMTP_RECIPIENTS=you@example.com
# LINE_NOTIFY_TOKEN=
